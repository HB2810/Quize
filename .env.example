# ==========================================================
# Stavya Awareness Platform — environment template
# Copy to .env (root, used by docker-compose) and per-app
# .env files as documented in each app. Never commit real
# secrets; both apps validate their environment at boot.
# ==========================================================

# --- Database (apps/api) ---
DATABASE_URL=postgresql://stavya:stavya_dev_password@localhost:5432/stavya_awareness

# --- API (apps/api) ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Public base URL of the API (share cards / OG images)
API_PUBLIC_URL=http://localhost:4000

# --- Web (apps/web) — only NEXT_PUBLIC_* reaches the browser ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000
